[gd_scene load_steps=3 format=3 uid="{{UID:scene}}"]

[ext_resource type="Script" uid="uid://cghtlla3sw0po" path="res://src/Core/Nodes/Combat/NCreatureVisuals.cs" id="1_vis"]
[ext_resource type="SpineSkeletonDataResource" uid="{{UID:skel}}" path="res://DonQuixote/animations/barry_skel_data.tres" id="2_skel"]

; 白月骑士-巴里：spine 版视觉（骨架由 tools/barry_spine.py 从 assets/art/barry_*.png 生成）。
; 为什么不用 Sprite2D：原版 NCreature 只在 %Visuals 是 SpineSprite 时才建 CreatureAnimator，
; 也只有那样才会在死亡时触发 "Dead" → 播骨架里的 die 动画（死亡图）。
;
; 几何由骨架里的附件自己算好（scale=1.4、脚底落在节点原点），所以这里节点 scale=1；
; %Bounds 与几个 Marker 沿用逐帧版场景的数值，血条/意图位置不变。
[node name="WhiteMoonKnightVisuals" type="Node2D"]
script = ExtResource("1_vis")

[node name="Visuals" type="SpineSprite" parent="."]
skeleton_data_res = ExtResource("2_skel")
preview_skin = "default"
preview_animation = "idle_loop"
unique_name_in_owner = true
position = Vector2(0, 0)

[node name="Bounds" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 0
offset_left = -180.0
offset_top = -376.0
offset_right = 180.0
mouse_filter = 2

[node name="VfxSpawnPosition" type="Marker2D" parent="."]
unique_name_in_owner = true
position = Vector2(0, -188)

[node name="CenterPos" type="Marker2D" parent="."]
unique_name_in_owner = true
position = Vector2(0, -188)

[node name="IntentPos" type="Marker2D" parent="."]
unique_name_in_owner = true
position = Vector2(0, -410)

[node name="TalkPos" type="Marker2D" parent="."]
unique_name_in_owner = true
position = Vector2(0, -330)

[node name="OrbPos" type="Marker2D" parent="."]
unique_name_in_owner = true
position = Vector2(0, -190)
