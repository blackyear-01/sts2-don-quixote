[ext_resource type="Texture2D" uid="{{UID:idle}}" path="res://DonQuixote/images/creatures/barry_idle.png" id="2_idle"]

; 几何说明（和 tools/barry_frames.py 的输出对应）：
;   帧画布 422x546，角色踩在画布 y=470 处，脸在画布水平中线。
;   贴图 scale=1.4 → 角色身高 214*1.4 = 300（和玩家角色一致），
;   position.y = -(470-273)*1.4 = -276.2，这样脚底正好落在 y=0。
;   %Bounds 取「角色 + 背后大刀鞘」的范围（高 376），血条与意图图标挂在它上方。
